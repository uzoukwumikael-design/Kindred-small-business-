# All optional. With no key the site still works using the built-in template drafter.
# Set ONE or MORE on Vercel (Project Settings > Environment Variables). They are tried in this order,
# and if one fails or is rate limited the next is used, then the template.

# 1. Google Gemini, free tier. Get a key at https://aistudio.google.com (Get API key)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# 2. Groq, free tier. Key at https://console.groq.com
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# 3. Paid options
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=

# Email sign-ups on the landing page. Kindling has no database, so each sign-up is POSTed as JSON
# ({ email, trade, source, at }) to this URL. Use a Formspree endpoint, a Zapier/Make webhook,
# or a Google Apps Script web app. Leave empty and the sign-up form is hidden.
WAITLIST_WEBHOOK_URL=

# Accounts and saving across devices (Supabase). Both are PUBLIC browser values, safe to expose; privacy
# comes from the Row Level Security in supabase/schema.sql. Find them in Supabase: Project Settings > API
# (the "anon" key, or the newer "publishable" key, both work). Leave empty and the site stays browser-only.
# These must be set in Vercel BEFORE the build, then redeploy.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Show "Continue with Google" on the sign-in page. Only set this to true AFTER Google is enabled in Supabase
# (Authentication > Providers > Google), or the button will fail.
# VITE_GOOGLE_AUTH=true

# Shown on the Privacy page for questions and deletion requests (optional).
# VITE_CONTACT_EMAIL=

# ---- Weekly summary email (optional, off until all of these are set) -------------------------------------
# These are SECRETS. Set them as normal Vercel environment variables. NEVER prefix them with VITE_.
# Supabase: Project Settings > API > service_role key. Gives full database access, keep it private.
# SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. Vercel sends it to /api/weekly so strangers cannot trigger the job. Also signs unsubscribe links.
# CRON_SECRET=
# One email provider. Use a sender address on a domain you have verified with the provider.
# RESEND_API_KEY=
# BREVO_API_KEY=
# EMAIL_FROM=Kindling <hello@yourdomain.com>
# Your business name and postal address, added to the bottom of each email.
# EMAIL_FOOTER=Your Business Ltd, 1 Example Road, Port Harcourt
# Your live address, used in email links. Defaults to the address the job is called on.
# SITE_URL=https://your-site.vercel.app
# Optional: cap on emails per daily run (default 90, under Resend's free 100 a day).
# WEEKLY_MAX_PER_RUN=90

# ---- Privacy page details (public, shown on /privacy) ---------------------------------------------------
# VITE_CONTROLLER_NAME=Your Business Ltd
# VITE_CONTROLLER_ADDRESS=1 Example Road, Port Harcourt, Nigeria
# VITE_DATA_REGION=EU (Ireland)

# ---- Pricing page (optional, public). With none set the page says everything is free. ---------------------
# Nothing is invented: set only what is true. The checkout link must be https and is opened in a new tab.
# The app itself has no billing system, so use a payment link from Paystack, Selar, Stripe or similar.
# VITE_PLAN_NAME=Supporter
# VITE_PLAN_PRICE=$9 a month
# VITE_PLAN_URL=https://your-payment-link
# VITE_PLAN_FEATURES=Priority help setting up|Crew templates

# Naira pricing (optional). Shown first to visitors in Nigeria, with a switch to the other currency if both are set.
# Make a payment link in Paystack or Selar and paste it here. Check any price you copy from another site yourself.
# VITE_PLAN_PRICE_NGN=₦5,000 a month
# VITE_PLAN_URL_NGN=https://paystack.com/pay/your-link

# Quick-draft box on the front page (a visitor can run this many drafts a day, and this many in total across all visitors).
# QUICK_DRAFT_DAILY_LIMIT=5
# QUICK_DRAFT_GLOBAL_CAP=300

# ---- Launch settings ---------------------------------------------------------------------------------
# Your live address. Used for email links, social previews and the health check.
# SITE_URL=https://your-site.vercel.app
# VITE_SITE_URL=https://your-site.vercel.app
# Shown on the Terms page (for example Nigeria). Leave empty to omit that section.
# VITE_GOVERNING_LAW=
# Check your live setup any time: curl -H "Authorization: Bearer $CRON_SECRET" https://your-site/api/health

# ---- Security check (Cloudflare Turnstile), optional -------------------------------------------------
# Create a Turnstile widget in Cloudflare. Put the SITE key here (public) and the SECRET key in TURNSTILE_SECRET_KEY.
# Also paste the same secret into Supabase (Authentication, Attack Protection) to protect sign-up and sign-in.
# Set both, or neither. A secret without a site key makes every form refuse every visitor.
# VITE_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ---- Alerts and messages (any Slack, Discord, Zapier or Make webhook), optional -----------------------
# Browser errors are posted here as short messages. They are always written to the server log too.
# ERROR_WEBHOOK_URL=
# The help page's contact form posts here. With none set the page shows your email address instead.
# FEEDBACK_WEBHOOK_URL=
