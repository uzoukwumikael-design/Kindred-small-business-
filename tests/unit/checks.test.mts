const { checkDraft } = await import("../../src/lib/kindling/checks.ts");
let bad = 0;
const t = (name: string, cond: boolean) => { if (!cond) bad++; console.log((cond ? "PASS " : "FAIL ") + name); };
const note = "Maria wants to move her Saturday 2pm to Sunday. We open Sunday 11 to 4. Total was $120.";
const facts = [{ value: "Mon to Sat 9am to 6pm. Closed Sunday." }, { value: "https://paystack.shop/braid" }];
const run = (draft: string, extra = {}) => checkDraft({ draft, note, facts, ...extra });
t("a draft built only from the note has no issues", run("Hi Maria, Sunday works at 2pm. The total is $120.").length === 0);
t("an invented amount is flagged", run("Hi Maria, the total is $135 including delivery.").some((i) => i.kind === "number" && i.detail.includes("$135")));
t("an invented time is flagged", run("See you Sunday at 3pm.").some((i) => i.kind === "number" && i.detail.includes("3pm")));
t("a time from the facts is accepted", run("We are open from 9am.").length === 0);
t("spacing differences are tolerated", run("See you at 2 pm.").length === 0);
t("an invented percentage is flagged", run("You get 10% off.").some((i) => i.detail.includes("10%")));
t("naira amounts are checked", checkDraft({ draft: "It costs \u20a615,000.", note: "how much?", facts: [] }).some((i) => i.kind === "number"));
t("a naira amount from the note is accepted", checkDraft({ draft: "It costs \u20a615,000.", note: "braids are \u20a615,000", facts: [] }).length === 0);
t("an unknown link is flagged", run("Pay here: https://evil.example/pay").some((i) => i.kind === "link"));
t("a link from the facts is accepted", run("Pay here: https://paystack.shop/braid.").length === 0);
t("an invented promise is flagged", run("It is free this week.").some((i) => i.kind === "promise" && i.detail.includes("free")));
t("a promise in the note is accepted", checkDraft({ draft: "Delivery is free.", note: "tell her delivery is free", facts: [] }).length === 0);
t("template phrases are flagged", run("I hope this finds you well. Thank you for reaching out.").filter((i) => i.kind === "phrase").length === 2);
t("long dashes are flagged", run("Sunday works \u2014 see you.").some((i) => i.detail.includes("long dash")));
t("brackets are not treated as claims", run("Sunday works. [CHECK: is 4pm free?]").length === 0);
t("a long whatsapp message is flagged", checkDraft({ draft: "word ".repeat(200), note: "x", facts: [], channel: "whatsapp", useChannel: true }).some((i) => i.kind === "length"));
t("length is ignored for jobs that are not messages", checkDraft({ draft: "word ".repeat(200), note: "x", facts: [], channel: "whatsapp", useChannel: false }).length === 0);
t("each problem is reported once", run("$135 and $135 again").filter((i) => i.kind === "number").length === 1);
process.exit(bad ? 1 : 0);
